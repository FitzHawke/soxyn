{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "@assets/*": ["./assets/*"],
      "@lib/*": ["./lib/*"],
      "@styles/*": ["style/*"],
      "@widgets/*": ["./widgets/*"]
    },
    "strict": true,
    "target": "ES2020"
  }
}
